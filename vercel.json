{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.prawalsharma.in"
        }
      ],
      "destination": "https://prawalsharma.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "prawal-personal-brand.vercel.app"
        }
      ],
      "destination": "https://prawalsharma.in/:path*",
      "permanent": true
    },
    {
      "source": "/references",
      "destination": "/recommendations",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(media|thumbs)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
